# Supabase — from your Supabase project's API settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Postgres connection string — used by Drizzle for migrations
# and runtime queries. Use the "Connection pooling" URI (port 6543) or the
# direct one (port 5432); either works for a dev slice.
DATABASE_URL=

# Plaid — Sandbox credentials from https://dashboard.plaid.com/developers/keys
# Leave PLAID_ENV=sandbox for this ticket. Do NOT touch development/production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Token encryption — base64-encoded 32-byte value used to encrypt Plaid and QBO
# tokens at rest (AES-256-GCM). Generate with `openssl rand -base64 32`.
# NEVER commit this value. If lost, every stored token becomes permanently
# unreadable and users must reconnect their Plaid and QBO accounts.
TOKEN_ENCRYPTION_KEY=
SENTRY_DSN=